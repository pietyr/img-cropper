{
  "name": "img-cropper",
  "version": "1.0.0",
  "description": "CLI that trims the empty (transparent / white / solid color) margin around images, e.g. company logos",
  "type": "module",
  "bin": {
    "img-trim": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node src/cli.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepare": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pietyr/img-cropper.git"
  },
  "license": "ISC",
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "typescript": "^7.0.2"
  }
}
